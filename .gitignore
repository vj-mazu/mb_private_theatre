# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files (secrets) — never commit these
.env
.env.*
!.env.example
*.key
*.p12
service-account*.json

# hosting tool folders
.vercel
.render
/.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

# logs
*.log
.dev.pid
/backups
/.next-test/
