# ─── Required ────────────────────────────────────────────────────────────────
# On a server, `sudo bash deploy/install.sh` writes this file for you.
# Your domain (no https://). Caddy gets the SSL certificate for it automatically.
DOMAIN=moviebash.in
NEXT_PUBLIC_APP_URL=https://moviebash.in

# Long random strings — generate with:  openssl rand -base64 48
JWT_SECRET=
POSTGRES_DB=moviebash
POSTGRES_USER=moviebash
POSTGRES_PASSWORD=

# First admin account (created automatically on the first start if no users exist).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ─── Database (only when NOT using docker-compose) ──────────────────────────
# docker-compose sets these itself. For a manual install, point to your PostgreSQL:
# DATABASE_URL=postgresql://moviebash:password@localhost:5432/moviebash
# DATABASE_SSL=false      # true for managed databases that require SSL

# ─── Optional ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BUSINESS_PHONE=+919902923656

# WhatsApp Cloud API (Meta) — https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANG=en
# Approved template names (needed for messages outside the 24-hour chat window).
# Body variables in order: {{1}} name {{2}} booking id {{3}} date {{4}} time {{5}} theatre
# {{6}} branch {{7}} total {{8}} paid {{9}} balance {{10}} ticket link
WHATSAPP_TEMPLATE_CONFIRMATION=
WHATSAPP_TEMPLATE_RECEIVED=
WHATSAPP_TEMPLATE_RESCHEDULE=
WHATSAPP_TEMPLATE_CANCELLATION=
WHATSAPP_TEMPLATE_REMINDER=
# Receives an alert for every payment screenshot to verify, and every enquiry.
# Guests get WhatsApp only after staff verify and confirm the booking.
WHATSAPP_ADMIN_NUMBER=
WHATSAPP_VERIFY_TOKEN=
