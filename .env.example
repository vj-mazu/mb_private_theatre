# Database Connection (Embedded High-Performance SQLite WAL)
SQLITE_DB_PATH=data/movie_bash.db

# Authentication & Admin
JWT_SECRET=your_jwt_secret_key_here
ADMIN_EMAIL=admin@moviebash.in
ADMIN_PASSWORD=your_admin_password_here

# Twilio WhatsApp & SMS Notifications
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_PHONE_NUMBER=
TWILIO_ADMIN_WHATSAPP=919448986953

# Payment Gateways (Optional)
NEXT_PUBLIC_ENABLE_RAZORPAY=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Public Site Settings & SEO Analytics
NEXT_PUBLIC_APP_URL=https://moviebash.in
NEXT_PUBLIC_GA_ID=
